            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-brand-oliveDark text-white pt-16 pb-8 border-t border-brand-gold/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-4 gap-8 pb-12 border-b border-white/10">
                
                <div class="space-y-4 md:col-span-1">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-brand-terracotta flex items-center justify-center text-brand-gold text-lg">
                            <i class="fa-solid fa-utensils"></i>
                        </div>
                        <span class="text-2xl font-black text-brand-cream">دار المذاق</span>
