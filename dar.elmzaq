                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-brand-olive text-lg">الهاتف للتواصل والطلبات</h4>
                                <p class="text-gray-600 text-sm mt-1">+20 100 000 0000 (رقم افتراضي)</p>
                            </div>
