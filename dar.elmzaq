    <!-- Shopping Cart Modal -->
    <div id="cart-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex justify-end">
        <div class="bg-white w-full max-w-md h-full shadow-2xl flex flex-col justify-between p-6 overflow-y-auto">
            <div>
                <div class="flex items-center justify-between pb-4 border-b">
                    <h3 class="text-xl font-bold text-brand-olive flex items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-brand-terracotta"></i>
                        <span>سلة الطلبات التجريبية</span>
                    </h3>
                    <button onclick="toggleCartModal()" class="text-gray-400 hover:text-red-500 text-2xl font-bold">&times;</button>
                </div>

                <div id="cart-items" class="py-6 space-y-4">
                    <!-- Cart items rendered dynamically -->
                </div>
            </div>

            <div class="pt-4 border-t space-y-4">
                <div class="flex justify-between items-center text-lg font-bold">
                    <span class="text-brand-olive">إجمالي الطلب:</span>
                    <span id="cart-total" class="text-brand-terracotta">0 ج.م</span>
                </div>
                <p class="text-xs text-gray-500">سيتم فتح تطبيق واتساب وإرسال ملخص الطلب مجهزاً برسالة تفصيلية تلقائياً.</p>
                <button onclick="sendOrderWhatsApp()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl transition-colors flex items-center justify-center gap-2 shadow-lg">
                    <i class="fa-brands fa-whatsapp text-xl"></i>
                    <span>إرسال الطلب عبر واتساب</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/201000000000" target="_blank" class="fixed bottom-6 left-6 z-30 bg-emerald-500 hover:bg-emerald-600 text-white w-14 h-14 rounded-full shadow-2xl flex items-center justify-center text-3xl transition-transform hover:scale-110">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <!-- JavaScript Data and Functions -->
    <script>
        const phonePlaceholder = "201000000000"; // International code without plus or spaces

        const menuData = [
            { id: 1, name: "كفتة مشوية بلدي", category: "grill", price: 180, desc: "لحم بلدي مفروم متبل بالأعشاب والبهارات الشرقية المشوية على الفحم.", img: "https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?auto=format&fit=crop&w=500&q=80" },
            { id: 2, name: "شيـش طاووق فاخر", category: "grill", price: 160, desc: "قطع صدور الدجاج المتبلة بالزبادي والليمون مع الفلفل الألوان والمشوية.", img: "https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?auto=format&fit=crop&w=500&q=80" },
            { id: 3, name: "ملوخية بالفراخ", category: "egyptian", price: 140, desc: "ملوخية خضراء بطشة الثوم والكسبرة تقدم مع نصف فرخة وأرز بالشعرية.", img: "https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=500&q=80" },
            { id: 4, name: "فتة لحمة ضأن", category: "egyptian", price: 220, desc: "عيش محمص مع الأرز الأبيض وصوص الخل والثوم يعلوها لحم ضأن محمر.", img: "https://images.unsplash.com/photo-1541518763669-27fef04b14ea?auto=format&fit=crop&w=500&q=80" },
            { id: 5, name: "حواوشي بلدي مخصوص", category: "egyptian", price: 90, desc: "خبز بلدي محشو باللحم المفروم المتبل والمطبوخ في الفرن الخشبي.", img: "https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=500&q=80" },
            { id: 6, name: "شوربة لسان عصفور", category: "starters", price: 40, desc: "شوربة دافئة غنية بلسان العصفور المحمر ومرقة الدجاج الطازجة.", img: "https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=500&q=80" },
            { id: 7, name: "طاجن أم علي بالمكسرات", category: "desserts", price: 65, desc: "رقائق الخبز بالبن والقشطة البلدي والمكسرات المحمصة في الفرن.", img: "https://images.unsplash.com/photo-1579372786545-d24232daf58c?auto=format&fit=crop&w=500&q=80" },
            { id: 8, name: "عصير قصب طازج / عصير مانجو", category: "drinks", price: 35, desc: "عصائر طبيعية طازجة منعشة بدون إضافة مواد حافظة.", img: "https://images.unsplash.com/photo-1534353473418-4cfa6c56fd38?auto=format&fit=crop&w=500&q=80" }
        ];

        let cart = [];

        function renderMenuItems(items) {
            const container = document.getElementById('menu-items-container');
            container.innerHTML = items.map(item => `
                <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-brand-creamDark flex flex-col justify-between hover:shadow-xl transition-shadow">
                    <div>
                        <div class="h-48 overflow-hidden relative">
                            <img src="${item.img}" alt="${item.name}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                        </div>
                        <div class="p-5">
                            <div class="flex justify-between items-start mb-2">
                                <h3 class="font-bold text-lg text-brand-olive">${item.name}</h3>
                                <span class="text-brand-terracotta font-black text-base whitespace-nowrap">${item.price} ج.م</span>
                            </div>
                            <p class="text-gray-500 text-xs leading-relaxed mb-4">${item.desc}</p>
                        </div>
                    </div>
                    <div class="px-5 pb-5">
                        <button onclick="addToCart('${item.name}', ${item.price})" class="w-full bg-brand-creamDark hover:bg-brand-terracotta hover:text-white text-brand-olive font-bold py-2.5 rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>اطلب الطبق</span>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function filterMenu(category) {
            document.querySelectorAll('.menu-tab').forEach(btn => {
                btn.classList.remove('bg-brand-olive', 'text-white');
                btn.classList.add('bg-white', 'text-brand-olive');
            });
            event.target.classList.remove('bg-white', 'text-brand-olive');
            event.target.classList.add('bg-brand-olive', 'text-white');

            if (category === 'all') {
                renderMenuItems(menuData);
            } else {
                renderMenuItems(menuData.filter(i => i.category === category));
            }
        }

        function addToCart(name, price) {
            const existing = cart.find(i => i.name === name);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ name, price, qty: 1 });
            }
            updateCartUI();
            toggleCartModal(true);
        }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if (cart[index].qty <= 0) cart.splice(index, 1);
            updateCartUI();
        }

        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const totalCount = cart.reduce((acc, i) => acc + i.qty, 0);
            const totalPrice = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);

            document.getElementById('cart-count').innerText = totalCount;
            document.getElementById('cart-count-mobile').innerText = totalCount;
            document.getElementById('cart-total').innerText = totalPrice + ' ج.م';

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `<p class="text-center text-gray-400 py-8">السلة فارغة حالياً</p>`;
                return;
            }

            cartItemsContainer.innerHTML = cart.map((item, index) => `
                <div class="flex items-center justify-between p-3 bg-brand-cream rounded-xl border border-brand-creamDark">
                    <div>
                        <h4 class="font-bold text-sm text-brand-olive">${item.name}</h4>
                        <p class="text-xs text-brand-terracotta font-semibold">${item.price} ج.م × ${item.qty}</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="changeQty(${index}, -1)" class="w-7 h-7 bg-white rounded-lg font-bold shadow hover:bg-gray-100">-</button>
                        <span class="text-sm font-bold w-4 text-center">${item.qty}</span>
                        <button onclick="changeQty(${index}, 1)" class="w-7 h-7 bg-white rounded-lg font-bold shadow hover:bg-gray-100">+</button>
                    </div>
                </div>
            `).join('');
        }

        function toggleCartModal(show = null) {
            const modal = document.getElementById('cart-modal');
            if (show === true) modal.classList.remove('hidden');
            else if (show === false) modal.classList.add('hidden');
            else modal.classList.toggle('hidden');
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        function sendOrderWhatsApp() {
            if (cart.length === 0) {
                alert('السلة فارغة! اختر بعض الأطباق أولاً.');
                return;
            }
            let message = "مرحباً مطعم دار المذاق 🍽️\nأرغب في طلب الأطباق التالية:\n\n";
            cart.forEach(item => {
                message += `- ${item.name} (عدد: ${item.qty}) -> ${item.price * item.qty} ج.م\n`;
            });
            const total = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
            message += `\nإجمالي الطلب: ${total} ج.م\n\nشكراً لكم!`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phonePlaceholder}?text=${encodedMessage}`, '_blank');
        }

        // Initial setup
        renderMenuItems(menuData);
    </script>
</body>
</html>
